# ── Server ─────────────────────────────────────────────────────────────
PORT=5000

# ── Global Payments (GP) ──────────────────────────────────────────────
GP_APP_ID=your_app_id_here
GP_APP_KEY=your_app_key_here
GP_ENV=sandbox

# ── Ngrok / Webhook URL ───────────────────────────────────────────────
# For GP sandbox testing, run: npx ngrok http 5000
# Then paste your ngrok URL here (e.g. https://xxxx.ngrok-free.app)
# In production, set this to your real domain.
WEBHOOK_URL=https://your-ngrok-url.ngrok-free.app

# ── Frontend URL ──────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Supabase ──────────────────────────────────────────────────────────
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_key

# ── Email OTP Authentication ─────────────────────────────────────────
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD="your_app_password"
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=7d
